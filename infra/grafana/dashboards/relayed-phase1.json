    {
      "id": 602,
      "title": "Invalidation delivery: pushes out vs reads woken",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "The loop, end to end. Pushes emitted by the sync engine against reads the registry actually refetched. Pushes climbing while woken stays flat means the write side is announcing topics nobody subscribes to \u2014 every open surface is then quietly stale, with no error anywhere.",
      "gridPos": {
        "x": 12,
        "y": 29,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "sum(count_over_time({service_name=\"relayed-desktop\"} | metric_name=\"sync.invalidate\" [$__auto]))",
          "legendFormat": "pushes emitted",
          "queryType": "range",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "sum(sum_over_time({service_name=\"relayed-desktop\"} | metric_name=\"ui.query.woken\" | unwrap metric_value [$__auto]))",
          "legendFormat": "reads woken",
          "queryType": "range",
          "refId": "B"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
