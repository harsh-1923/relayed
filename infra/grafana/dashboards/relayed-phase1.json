    {
      "id": 501,
      "title": "Identity and storage events",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Every event carrying account, device, actor and workspace ids. This is what answers \"why did THIS user's switch hang\" \u2014 and it is gone in 14 days, which is why the aggregates above have to exist as metrics.",
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "{service_name=~\"relayed-.+\"} | event_name=~\"auth\\\\..+|account\\\\..+|workspace\\\\..+|identity\\\\..+|blob\\\\.served\"",
          "legendFormat": "",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
