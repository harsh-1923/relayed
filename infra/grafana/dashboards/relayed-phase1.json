{
  "uid": "relayed-phase1",
  "title": "Relayed \u2014 identity & storage",
  "tags": [
    "relayed",
    "phase-1"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "editable": true,
  "description": "Phase 1: identity, the storage split, workspace switching and blobs. Everything here reads from Loki, because the sink emits metrics as log records (OBSERVABILITY.md \u00a710b).",
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Invariants \u2014 every one of these should read 0",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 101,
      "title": "R3 violations: network before first paint",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Any value above 0 means the read path waited on the network before the UI could paint. A counter at zero emits nothing, so an empty panel is the healthy state.",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "sum(count_over_time({service_name=~\"relayed-.+\"} | metric_name=\"boot.network_calls_before_paint\" [$__range]))",
          "legendFormat": "",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "sum"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "0",
                  "index": 0
                }
              }
            }
          ],
          "unit": "short"
        },
        "overrides": []
      }
    },
