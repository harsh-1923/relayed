        "type": "loki",
        "uid": "loki"
      },
      "description": "The number two decisions rest on: not adopting a server-state cache, and refetching coarsely instead of diffing. Both are correct at ~1ms and wrong at 40ms. `invalidate` is the line that degrades first, because it competes with whatever wrote.",
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "quantile_over_time(0.95, {service_name=\"relayed-desktop\"} | metric_name=\"ui.query.duration\" | trigger=\"mount\" | unwrap metric_value [$__auto])",
          "legendFormat": "mount p95",
          "queryType": "range",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "quantile_over_time(0.95, {service_name=\"relayed-desktop\"} | metric_name=\"ui.query.duration\" | trigger=\"invalidate\" | unwrap metric_value [$__auto])",
          "legendFormat": "invalidate p95",
          "queryType": "range",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "quantile_over_time(0.95, {service_name=\"relayed-desktop\"} | metric_name=\"ui.query.duration\" | trigger=\"epoch\" | unwrap metric_value [$__auto])",
          "legendFormat": "switch p95",
          "queryType": "range",
          "refId": "C"
        }
