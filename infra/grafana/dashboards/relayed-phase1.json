    {
      "id": 202,
      "title": "Workspaces per identity",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Sampled at every session exchange. The distribution multi-workspace was built for \u2014 and unrecoverable later, since the logs behind it are gone in 14 days.",
      "gridPos": {
        "x": 8,
        "y": 7,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "quantile_over_time(0.5, {service_name=\"relayed-server\"} | metric_name=\"identity.memberships\" | unwrap metric_value [$__auto])",
          "legendFormat": "p50",
          "queryType": "range",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "quantile_over_time(0.95, {service_name=\"relayed-server\"} | metric_name=\"identity.memberships\" | unwrap metric_value [$__auto])",
          "legendFormat": "p95",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
