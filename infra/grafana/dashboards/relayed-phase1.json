    {
      "id": 301,
      "title": "Workspace switch \u2014 local phase vs authorized",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "THE chart for STORAGE.md \u00a712.2. `local` is everything the user waits on \u2014 durable write, close, open, repaint \u2014 and must stay flat. `authorized` is token and socket work, is allowed to be slow, and is unbounded offline. One line covering both would hide a regression in the half that matters.",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "quantile_over_time(0.95, {service_name=\"relayed-desktop\"} | metric_name=\"workspace.switch\" | phase=\"local\" | unwrap metric_value [$__auto])",
          "legendFormat": "local p95",
          "queryType": "range",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "quantile_over_time(0.95, {service_name=\"relayed-desktop\"} | metric_name=\"workspace.switch\" | phase=\"authorized\" | unwrap metric_value [$__auto])",
          "legendFormat": "authorized p95",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    },
