# Copy to .env for local development:  cp .env.example .env
# Values here match compose.yaml. They are development credentials, not secrets.

# ─── Postgres (authoritative log) ────────────────────────────────────────────
DATABASE_URL=postgres://relayed:relayed@localhost:5432/relayed

# ─── Redis (fanout, presence, rate limiting — nothing durable) ───────────────
REDIS_URL=redis://localhost:6379

# ─── Blob storage (S3-compatible; MinIO locally, R2 in production) ───────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=relayed-blobs
S3_ACCESS_KEY_ID=relayed
S3_SECRET_ACCESS_KEY=relayedsecret
S3_FORCE_PATH_STYLE=true          # MinIO needs path-style; R2/S3 do not

# ─── Host port overrides (only if something already owns these) ──────────────
# POSTGRES_PORT=5432
# REDIS_PORT=6379
# MINIO_PORT=9000
# MINIO_CONSOLE_PORT=9001

# ─── WorkOS (docs/DESIGN.md §6.2) — fill in when auth work starts ────────────
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
# Loopback is the primary redirect (DESIGN.md §13.1): relayed:// does not
# resolve for an unpackaged app on macOS. Both are registered in WorkOS; the
# loopback ones are http://127.0.0.1:<port>/auth/callback for the ports the
# listener may bind.
WORKOS_REDIRECT_URI=relayed://auth/callback
# Issuer and JWKS are read from OIDC discovery at
#   /user_management/<client_id>/.well-known/openid-configuration
# and are never hardcoded. Note the AuthKit domain has its OWN discovery doc
# describing a different product surface — it is not the one to use here.

# ─── Telemetry (dev) ─────────────────────────────────────────────────────────
# Set to tee events to the local collector; unset for console only.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=8787
# 1 registers /dev routes (apps/server/src/web/dev.ts) — today, writing a
# message only some people can see, which no client can do. Development only.
# RELAYED_DEV_ROUTES=1
# Ed25519 keypair signing our session tokens. Generate with:
#   pnpm --filter @relayed/server keygen
# Asymmetric so a verify-only service (the agents runtime) holds only the public
# key and cannot mint tokens. Rotating the private key invalidates every session.
SESSION_PRIVATE_KEY=
SESSION_PUBLIC_KEY=
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000

# ─── Agent runtime (docs/AGENT-RUNTIME.md) ───────────────────────────────────
# Absent AGENT_S2S_KEY or AGENT_PROVIDERS, `pnpm dev` skips the agent runtime
# and says so. The service itself refuses to boot without them — this endpoint
# executes model-authored shell, so there is no unauthenticated mode (§5).
AGENT_PORT=8788
AGENT_S2S_KEY=
# The provider table (§4). pi picks an adapter by WIRE FORMAT, not by vendor:
# LiteLLM and Vercel AI Gateway are both openai-completions with a base URL,
# Anthropic direct is anthropic-messages. List the entries, then describe each.
AGENT_PROVIDERS=litellm
# Served when a request names no model. LiteLLM fronts everything, so it is the
# fallback every run lands on.
AGENT_MODEL_FALLBACK=litellm/
AGENT_PROVIDER_LITELLM_BASE_URL=
AGENT_PROVIDER_LITELLM_API_KEY=
AGENT_PROVIDER_LITELLM_MODELS=
# Required: pi does not discover it, and a wrong value reads as model
# misbehaviour rather than as a config error (§4, trap 3).
AGENT_PROVIDER_LITELLM_CONTEXT_WINDOW=200000
AGENT_PROVIDER_LITELLM_MAX_TOKENS=16384
# Set false for a model with no reasoning support; leaving it true on a
# non-reasoning model is harmless, the reverse silently drops the thinking level.
AGENT_PROVIDER_LITELLM_REASONING=true
# How this proxy spells "no thinking". OpenAI-compatible proxies want `none`;
# without it the off switch does nothing (§4, trap 4).
AGENT_PROVIDER_LITELLM_THINKING_OFF=none
# Bounds (§6). Every run is capped on all four.
AGENT_MAX_CONCURRENT_RUNS=4
AGENT_RUN_TIMEOUT_MS=300000
AGENT_MAX_TURNS=40
