{
  "name": "relayed",
  "version": "0.0.0",
  "private": true,
  "description": "The workspace of tomorrow \u2014 humans and agents collaborating, local-first.",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "services": "docker compose up -d --wait postgres redis minio lgtm && docker compose up -d minio-init",
    "services:down": "docker compose down",
    "dev": "pnpm -r --parallel dev",
    "services:reset": "docker compose down -v && pnpm services",
    "services:lite": "docker compose up -d --wait postgres redis minio && docker compose up -d minio-init",
    "services:logs": "docker compose logs -f",
    "services:ps": "docker compose ps",
    "build": "pnpm --filter @relayed/desktop build",
    "preview": "pnpm --filter @relayed/desktop start",
    "ui": "pnpm --filter @relayed/desktop exec vite",
    "check:boundaries": "node tools/check-boundaries.mjs",
    "typecheck": "pnpm -r typecheck && pnpm check:boundaries",
    "psql": "docker compose exec postgres psql -U relayed -d relayed",
    "redis-cli": "docker compose exec redis redis-cli",
    "grafana": "open http://localhost:3000",
    "otel:smoke": "node scripts/otel-smoke.mjs",
    "spike:sync": "node spikes/sync-tests.mjs",
    "spike:authz": "node spikes/authz-tests.mjs",
    "verify:sqlite": "npm --prefix spikes/electron-verify run sqlite",
    "verify:timer": "npm --prefix spikes/electron-verify run timer",
    "test": "pnpm -r test"
  }
}
