node_modules/
dist/
out/
build/
coverage/
*.tsbuildinfo

# local runtime state
*.db
*.db-wal
*.db-shm
.env
.env.*
!.env.example

# editor / os
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
# Shared, because it is a project decision rather than a personal one: which
# formatter owns which extension, and that saving a .ts file runs ESLint's fixer
# and not Prettier (see .prettierignore). Everything else under .vscode stays
# personal.
!.vscode/settings.json

*.log

# generated from docs/DESIGN.md by extract-schema.mjs
schema.sql

# local editable sync-flow canvases (generated with tldraw offline)
/docs/sync-whiteboards/

# local Graphify output
/graphify-out/

# The icon pipeline stays local: @relayed/icons ships the icons, not the
# machinery that produced them. Listed HERE rather than in the package's own
# .gitignore because eslint reads this file and only this one
# (eslint.config.mjs), so git and lint agree about what is not here.
/packages/icons/scripts/
/packages/icons/incomplete-icons.json

.codex

# A read-only dump of this Mac's local databases, including the text of local
# chats. Generated on request; never committed.
/local-db-report.md

# Composio spike debug dumps; may hold the API key
spikes/composio-connect/.last-request*.json

# electron-builder output.
apps/desktop/release/

# apps/web (Next.js). Listed HERE rather than in the app's own .gitignore for
# the same reason as the icon pipeline above: eslint reads this file and only
# this one (eslint.config.mjs), so a build output that git ignores is also a
# build output lint never walks into.
/apps/web/.next/
/apps/web/.vercel/
# Regenerated by `next typegen`, `next dev` and `next build`.
/apps/web/next-env.d.ts
# Written by `vercel link` — a project id and an OIDC token, neither ours
# to publish. Vercel drops its own apps/web/.gitignore saying the same
# thing; it is deleted on sight so this file stays the only list.
/apps/web/.env*
