{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": { "@/*": ["./src/renderer/*"] },
    "noEmit": true,

    // Relaxed ONLY for the renderer, because src/renderer/components/ui is
    // vendored shadcn source that the CLI overwrites on `add --overwrite`.
    // Patching it would be undone by the next component update, so the flags
    // are scoped instead. tsconfig.node.json and tsconfig.preload.json keep
    // both enabled — we own every line there.
    //
    //   exactOptionalPropertyTypes: react-day-picker passes `locale: T | undefined`
    //   noUnusedLocals:             scroll-area carries an unused React import
    "exactOptionalPropertyTypes": false,
    "noUnusedLocals": false
  },
  "include": [
    "src/renderer/**/*.ts",
    "src/renderer/**/*.tsx",
    "src/shared/**/*.ts",
    "src/preload/api.d.ts"
  ],
  // Tests run under `node --test` and import node:test, which this config
  // deliberately has no types for — the renderer must not see node globals.
  // tsconfig.node.json checks them instead.
  "exclude": ["**/node_modules", "**/dist", "**/out", "**/*.test.ts"]
}
