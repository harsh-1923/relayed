{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": [
      "node",
      "electron-vite/node"
    ],
    "lib": [
      "ES2023"
    ],
    "noEmit": true
  },
  "include": [
    "src/main/**/*.ts",
    "src/sync/**/*.ts",
    "src/agent-runner/**/*.ts",
    "src/shared/**/*.ts",
    "electron.vite.config.ts",
    "src/renderer/**/*.test.ts"
  ]
}
